{
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT:-$HOME/.codex}/hooks/babysitter-proxied-session-start.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT:-$HOME/.codex}/hooks/babysitter-proxied-stop.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT:-$HOME/.codex}/hooks/babysitter-proxied-pre-tool-use.sh\""
          }
        ]
      }
    ]
  }
}
