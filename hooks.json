{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-}}\" ]; then exec bash \"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/babysitter-codex-session-start.sh\"; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-}}\" ]; then exec bash \"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/babysitter-codex-stop.sh\"; fi"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-}}\" ]; then exec bash \"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/babysitter-codex-user-prompt-submit.sh\"; fi"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-}}\" ]; then exec bash \"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/babysitter-codex-pre-tool-use.sh\"; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-}}\" ]; then exec bash \"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/babysitter-codex-post-tool-use.sh\"; fi"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-}}\" ]; then exec bash \"${CLAUDE_PLUGIN_ROOT:-$PLUGIN_ROOT}/hooks/babysitter-codex-session-end.sh\"; fi"
          }
        ]
      }
    ]
  }
}
